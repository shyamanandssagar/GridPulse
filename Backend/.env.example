GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OTP_EXPIRES_MIN=10


SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GRIDPULSE <no-reply@yourdomain.com>