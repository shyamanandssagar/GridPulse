# GridPulse — Frontend environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Backend REST API base URL. In dev, the Vite proxy forwards /api to localhost:5000
# so you can leave this blank for development.
VITE_API_URL=

# Backend Socket.IO URL. Leave blank in dev (defaults to window.location.origin
# which the Vite proxy also handles).
VITE_SOCKET_URL=

# Google OAuth 2.0 Client ID. If unset, the Google sign-in button renders a
# polite "not configured" placeholder so email/password login still works.
VITE_GOOGLE_CLIENT_ID=
